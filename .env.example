# Default remains the current Markdown website until the migration is verified.
CONTENT_SOURCE=markdown
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Server-only Viewer token for a PRIVATE dataset; never prefix tokens with NEXT_PUBLIC.
SANITY_API_READ_TOKEN=
# Temporary Editor token, used only by the import command. Do not set on Vercel.
SANITY_API_WRITE_TOKEN=
# Independent random secrets, at least 32 characters each.
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=
